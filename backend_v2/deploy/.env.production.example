# Server: /opt/home-tour/backend/.env  (owner deploy, chmod 600)
# Image tag used by docker-compose.yml. CI sets it to a number (pipeline number or manual IMAGE_VERSION) on each deploy.
# Edit it to run an older image, then `docker compose up -d`.
VERSION=dev-latest

NODE_ENV=production
PORT=3000

# Existing Postgres on this host (network_mode: host)
# With docker-compose.host-gateway.yml use DB_HOST=host.docker.internal
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=
DB_PASSWORD=
DB_DATABASE=home_tour_v2

# Use long random values: openssl rand -base64 48
JWT_TEMP_SECRET=
JWT_SECRET=
JWT_REFRESH_SECRET=

# Path inside the container, mounted from ./uploads on the host
STORAGE_UPLOAD_PATH=/app/uploads
STORAGE_PUBLIC_URL=https://api.your-domain.com/uploads
STORAGE_MAX_FILE_SIZE=10485760
STORAGE_MAX_FILES_PER_REQUEST=10
STORAGE_ALLOWED_MIME_TYPES=
STORAGE_ALLOWED_EXTENSIONS=
STORAGE_ENABLE_IMAGE_VALIDATION=true
