{
  "expo": {
    "name": "Home Tour",
    "slug": "home-tour",
    "version": "1.0.0",
    "orientation": "light",
    "icon": "./logo/ios/AppIcon.appiconset/AppIcon-1024-dark.png",    
    "userInterfaceStyle": "automatic",
    "platforms": ["ios", "android"],
    "plugins": [
      "./plugins/withSceneLifecycle",
      [
        "expo-splash-screen",
        {
          "image": "./logo/ios/AppIcon-1024.png",
          "resizeMode": "contain",
          "backgroundColor": "#2B2580"
        }
      ],
      [
        "expo-document-picker",
        {
          "iCloudContainerEnvironment": "Production"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "The app accesses your photos to let you upload them."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "The app accesses your camera to let you upload videos."
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "ios": {
      "supportsTablet": true,
      "name": "",
      "icon": {
        "light": "./logo/ios/AppIcon.appiconset/AppIcon-1024-light.png",
        "dark": "./logo/ios/AppIcon.appiconset/AppIcon-1024-light.png",
        "tinted": "./logo/ios/AppIcon.appiconset/AppIcon-1024-tinted.png"
      },
      "bundleIdentifier": "com.hometour.mobile",
      "buildNumber": "1"
    },
    "android": {
      "softwareKeyboardLayoutMode": "pan",
      "adaptiveIcon": {
        "foregroundImage": "./logo/android/adaptive-foreground-432.png",
        "backgroundImage": "./logo/android/adaptive-background-432.png",
        "monochromeImage": "./logo/android/adaptive-monochrome-432.png",
        "backgroundColor": "#2B2580"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "extra": {
      "eas": {
        "projectId": "4c6d8506-6e7e-4b71-bbbc-8c0dad6e22a8"
      }
    },
    "owner": "ntnduc"
  }
}
